# Local development template. Replace the password placeholder below before starting PostgreSQL.
NODE_ENV=development
API_PORT=3001
PUBLIC_BASE_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173
POSTGRES_USER=linkpulse
# Use the same local-only password in POSTGRES_PASSWORD and DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
POSTGRES_DB=linkpulse
DATABASE_URL=postgresql://linkpulse:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/linkpulse
REDIS_URL=redis://localhost:6379
# Required by the API. Set a unique random value of at least 32 bytes.
SESSION_SECRET=
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CREATE_MAX=30
RATE_LIMIT_REDIRECT_MAX=120
RATE_LIMIT_ANALYTICS_MAX=120
